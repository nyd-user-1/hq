{
  "name": "@nysgpt/hq",
  "version": "0.1.1",
  "description": "Localhost observability + control layer for Claude Code — live transcript mirror, token & cost accounting, cross-repo search, two-way session channel. Disk is the database: no DB, no auth, no telemetry.",
  "license": "MIT",
  "keywords": [
    "claude",
    "claude-code",
    "observability",
    "dashboard",
    "tokens",
    "cost",
    "transcripts",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nyd-user-1/hq.git"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "hq": "bin/hq",
    "claude-hq": "bin/claude-hq"
  },
  "files": [
    "bin/",
    "scripts/hooks/",
    "scripts/hq-shell.swift",
    "scripts/make-macos-app-native.sh",
    ".next/standalone/",
    "README.md"
  ],
  "scripts": {
    "dev": "next dev -p 3002 -H 127.0.0.1",
    "build": "next build",
    "build:check": "HQ_BUILD_DIR=.next-build next build",
    "build:offline": "next build && rm -rf .next/standalone/.next/static .next/standalone/public .next/standalone/.claude .next/standalone/tsconfig.tsbuildinfo && cp -R .next/static .next/standalone/.next/static && cp -R public .next/standalone/public && mkdir -p .next/standalone/lib .next/standalone/scripts/lib && cp lib/repl-daemon.mjs lib/permission-classify.mjs .next/standalone/lib/ && cp scripts/build-search-index.mjs scripts/fetch-docs.mjs .next/standalone/scripts/ && cp scripts/lib/extract-entry.mjs .next/standalone/scripts/lib/",
    "start": "next start",
    "lint": "eslint",
    "app:rebuild": "bash scripts/rebuild-app.sh",
    "test:permission": "node --experimental-strip-types --test lib/permission-policy.test.mts",
    "prepublishOnly": "env -u NODE_ENV npm run build:offline"
  },
  "dependencies": {
    "next": "16.2.9",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-dropcursor": "^1.8.2",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.4",
    "prosemirror-model": "^1.25.9",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
