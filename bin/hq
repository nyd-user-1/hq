#!/usr/bin/env bash
# hq — the one front door.
#
#   hq             macOS: open the native HQ.app (building it on first run when the
#                  toolchain allows); everywhere else — or when the Mac has no Xcode
#                  Command Line Tools — serve at localhost and open the browser.
#   hq --browser   force the browser experience (any platform)
#   hq --app       force the native app path (macOS; errors without swiftc)
#
# Run from inside a Claude Code session and CLAUDE_CODE_SESSION_ID pins that
# session as Terminal 1 in the browser flow.
set -uo pipefail

MODE="auto"
for a in "$@"; do
  case "$a" in
    --browser) MODE="browser" ;;
    --app) MODE="app" ;;
  esac
done

# Resolve our own location (following npm's bin symlink) so we find the app
# wherever it's installed — the repo in dev, npm's global dir once published.
# Override with HQ_DIR=... if you keep the app somewhere unusual.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  dir="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [ "${SOURCE#/}" = "$SOURCE" ] && SOURCE="$dir/$SOURCE"
done
SELF_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
HQ_DIR="${HQ_DIR:-$(cd "$SELF_DIR/.." && pwd)}"
export HQ_DIR                       # the app reads it to locate scripts/hooks

APP="${HQ_APP_INSTALL:-$HOME/Applications}/HQ.app"
BUILDER="$HQ_DIR/scripts/make-macos-app-native.sh"

app_version() {  # version baked into the installed app ("" when absent)
  /usr/libexec/PlistBuddy -c "Print CFBundleShortVersionString" "$APP/Contents/Info.plist" 2>/dev/null || true
}
pkg_version() {
  node -p "require('$HQ_DIR/package.json').version" 2>/dev/null || echo ""
}

# ── the native path: macOS tier 1 ───────────────────────────────────────────
if [ "$MODE" != "browser" ] && [ "$(uname -s)" = "Darwin" ]; then
  if [ -f "$BUILDER" ] && { [ -f "$HQ_DIR/native/hq-shell" ] || command -v swiftc >/dev/null 2>&1; }; then
    if [ ! -d "$APP" ] || { [ -n "$(pkg_version)" ] && [ "$(app_version)" != "$(pkg_version)" ]; }; then
      echo "Building the native HQ.app ($(pkg_version)) — first run or new version..."
      bash "$BUILDER" || { echo "native build failed — falling back to the browser."; MODE="browser"; }
    fi
    if [ "$MODE" != "browser" ] && [ -d "$APP" ]; then
      open "$APP"
      echo "HQ is open in its own window. (⌘B inside the app opens the browser view; \`hq --browser\` starts it directly.)"
      exit 0
    fi
  elif [ "$MODE" = "app" ]; then
    echo "no prebuilt shell in this install and no swiftc — cannot build the native app here."
    exit 1
  fi
fi

# ── the browser path: everywhere else, and every fallback ───────────────────
# Packaged install: a prebuilt standalone bundle ships in the tarball — serve it
# with plain node (no dev toolchain, no install, instant start). A dev clone has
# no standalone, so fall through to `npm run dev`.
if [ -f "$HQ_DIR/.next/standalone/server.js" ]; then
  exec "$SELF_DIR/hq-offline" "$@"
fi

HQ_PORT="${HQ_PORT:-3002}"
BASE="http://localhost:${HQ_PORT}"

# Pin to the launching session when we have its id (we always do under Claude).
sid="${CLAUDE_CODE_SESSION_ID:-}"
url="$BASE/"
[ -n "$sid" ] && url="$BASE/?session=$sid"

up() { curl -sf -o /dev/null --max-time 2 "$BASE/"; }

ready=1
if ! up; then
  echo "Starting HQ on $BASE ..."
  ( cd "$HQ_DIR" && nohup npm run dev >/tmp/hq-dev.log 2>&1 & ) >/dev/null 2>&1
  ready=0
  for _ in $(seq 1 120); do        # tolerate a cold first compile after a reboot
    if up; then ready=1; break; fi
    sleep 0.5
  done
fi

if command -v open >/dev/null 2>&1; then
  open "$url"
elif command -v xdg-open >/dev/null 2>&1; then
  xdg-open "$url"
fi

if [ "$ready" = 1 ]; then
  printf '\nHQ is now open on %s\n' "$BASE"
else
  printf '\nHQ is starting on %s — give it a few seconds and refresh if the page is blank.\n' "$BASE"
fi
