#!/usr/bin/env bash
# hq-app — build HQ.app, the native macOS window (NSWindow + WKWebView) around the
# bundled offline server, and open it. Self-built on this machine, so no Apple
# signing or notarization is needed. Requires the Xcode Command Line Tools
# (xcode-select --install). Installs to ~/Applications (override: HQ_APP_INSTALL).
set -euo pipefail

case "$(uname -s)" in
  Darwin) ;;
  *) echo "hq-app builds a macOS app — on this platform, use \`hq\` (browser) instead."; exit 1 ;;
esac

# Resolve our own location through npm's bin symlink — mirrors bin/hq.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  dir="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [ "${SOURCE#/}" = "$SOURCE" ] && SOURCE="$dir/$SOURCE"
done
SELF_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
HQ_DIR="${HQ_DIR:-$(cd "$SELF_DIR/.." && pwd)}"

BUILDER="$HQ_DIR/scripts/make-macos-app-native.sh"
[ -f "$BUILDER" ] || { echo "build script not found at $BUILDER"; exit 1; }

bash "$BUILDER"

APP="${HQ_APP_INSTALL:-$HOME/Applications}/HQ.app"
[ -d "$APP" ] && open "$APP"
